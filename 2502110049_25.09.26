{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyO4WjBVxR90dLTAhguGLh7Y"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["IT12"],"metadata":{"id":"Km8ctKZz4cx5"}},{"cell_type":"code","execution_count":1,"metadata":{"id":"7bGAaEGh37_o","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1791351887322,"user_tz":-330,"elapsed":31,"user":{"displayName":"N. Shashi Kiran","userId":"01258008085051097428"}},"outputId":"8232f90e-8ac9-41d7-d47e-6bc00b28857f"},"outputs":[{"output_type":"stream","name":"stdout","text":["Line count: 19\n"]}],"source":["import os\n","\n","os.makedirs(\"data\", exist_ok=True)\n","\n","lines = [\n","    \"AB-1042 | 120 | 3\",\n","    \"AB-1042 | 95 | 1\",\n","    \"CD-2001 | 200 | 10\",\n","    \"CD-2001 | 180 | 4\",\n","    \"EF-3310 | 60 | 0\",\n","    \"EF-3310 | 75 | 2\",\n","    \"GH-4500 | 310 | 12\",\n","    \"GH-4500 | 290 | 9\",\n","    \"AB-1042|110|2\",               # no spaces\n","    \"CD-2001   |   150   |   5\",   # ugly spacing\n","    \"IJ-5120 | 88 | 1\",\n","    \"IJ-5120 | 92 | 3\",\n","    \"KL-6001 | 140 | 7\",\n","    # ---- filthy lines ----\n","    \"\",                            # blank line\n","    \"AB-1042 | 120\",               # missing field\n","    \"XY-99 | 50 | 1\",              # bad part code\n","    \"CD-2001 | abc | 3\",           # non-numeric\n","    \"EF-3310 | -40 | 1\",           # negative\n","    \"GH-4500 | 20 | 50\",           # scrap > produced\n","]\n","\n","with open(\"data/shift_log.txt\", \"w\", encoding=\"utf-8\") as f:\n","    for line in lines:\n","        f.write(line + \"\\n\")\n","\n","with open(\"data/shift_log.txt\", \"r\", encoding=\"utf-8\") as f:\n","    content = f.readlines()\n","\n","print(\"Line count:\", len(content))"]},{"cell_type":"markdown","source":["IT10"],"metadata":{"id":"nILAW1ri47VB"}},{"cell_type":"code","source":["import csv\n","from collections import defaultdict\n","\n","INPUT = \"data/shift_log.txt\"\n","REPORT = \"data/report.txt\"\n","REJECTS = \"data/rejects.csv\"\n","\n","\n","def parse_line(line):\n","    \"\"\"Return ((part, produced, scrap), None) or (None, reason).\"\"\"\n","    if not line.strip():\n","        return None, \"blank line\"\n","    parts = [p.strip() for p in line.split(\"|\")]\n","    if len(parts) != 3:\n","        return None, \"wrong number of fields\"\n","    part, produced, scrap = parts\n","    if not part:\n","        return None, \"empty part code\"\n","    try:\n","        produced = int(produced)\n","        scrap = int(scrap)\n","    except ValueError:\n","        return None, \"non-numeric quantity\"\n","    if produced < 0 or scrap < 0:\n","        return None, \"negative quantity\"\n","    if scrap > produced:\n","        return None, \"scrap exceeds produced\"\n","    return (part, produced, scrap), None\n","\n","\n","# ---- read -> parse -> validate -> aggregate ----\n","totals = defaultdict(lambda: {\"produced\": 0, \"scrap\": 0, \"n\": 0})\n","rejects = []\n","records = 0\n","\n","with open(INPUT, \"r\", encoding=\"utf-8\") as f:\n","    for line_no, raw in enumerate(f, start=1):\n","        line = raw.rstrip(\"\\n\")\n","        records += 1\n","        data, reason = parse_line(line)\n","        if reason:\n","            rejects.append([line_no, line, reason])\n","            continue\n","        part, produced, scrap = data\n","        totals[part][\"produced\"] += produced\n","        totals[part][\"scrap\"] += scrap\n","        totals[part][\"n\"] += 1\n","\n","# ---- write report.txt (aligned columns) ----\n","with open(REPORT, \"w\", encoding=\"utf-8\") as f:\n","    f.write(\"SHIFT REPORT\\n\")\n","    f.write(\"=\" * 56 + \"\\n\")\n","    f.write(f\"{'PART':<10}{'RECORDS':>8}{'PRODUCED':>12}{'SCRAP':>8}{'SCRAP %':>10}\\n\")\n","    f.write(\"-\" * 56 + \"\\n\")\n","    gp = gs = gn = 0\n","    for part in sorted(totals):\n","        t = totals[part]\n","        pct = 100 * t[\"scrap\"] / t[\"produced\"] if t[\"produced\"] else 0\n","        f.write(f\"{part:<10}{t['n']:>8}{t['produced']:>12,}{t['scrap']:>8,}{pct:>9.2f}%\\n\")\n","        gp += t[\"produced\"]; gs += t[\"scrap\"]; gn += t[\"n\"]\n","    f.write(\"-\" * 56 + \"\\n\")\n","    gpct = 100 * gs / gp if gp else 0\n","    f.write(f\"{'TOTAL':<10}{gn:>8}{gp:>12,}{gs:>8,}{gpct:>9.2f}%\\n\")\n","    f.write(f\"\\nLines read: {records}  Accepted: {gn}  Rejected: {len(rejects)}\\n\")\n","\n","# ---- write rejects.csv ----\n","with open(REJECTS, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n","    w = csv.writer(f)\n","    w.writerow([\"line_no\", \"raw_line\", \"reason\"])\n","    w.writerows(rejects)\n","\n","print(f\"Done. {records} lines, {len(rejects)} rejected.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"TNaJSuir49tf","executionInfo":{"status":"ok","timestamp":1791351894027,"user_tz":-330,"elapsed":15,"user":{"displayName":"N. Shashi Kiran","userId":"01258008085051097428"}},"outputId":"34f7fa65-c1f1-43e9-f0b4-037782a79e01"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["Done. 19 lines, 5 rejected.\n"]}]},{"cell_type":"markdown","source":["IT08"],"metadata":{"id":"d7ARu7604-Me"}},{"cell_type":"code","source":["def parse_line(line):\n","    \"\"\"Return ((part, produced, scrap), None) or (None, reason).\"\"\"\n","    m = LINE_RE.match(line)\n","    if not m:\n","        # figure out WHY it failed, for rejects.csv\n","        if not line.strip():\n","            return None, \"blank line\"\n","        fields = [p.strip() for p in line.split(\"|\")]\n","        if len(fields) != 3:\n","            return None, \"wrong number of fields\"\n","        if not re.fullmatch(r\"[A-Z]{2}-\\d{4}\", fields[0]):\n","            return None, f\"bad part code '{fields[0]}'\"\n","        return None, \"non-numeric quantity\"\n","\n","    part = m.group(1)\n","    produced = int(m.group(2))\n","    scrap = int(m.group(3))\n","\n","    if produced < 0 or scrap < 0:\n","        return None, \"negative quantity\"\n","    if scrap > produced:\n","        return None, \"scrap exceeds produced\"\n","    return (part, produced, scrap), None"],"metadata":{"id":"6LD_8X1v4_hr","executionInfo":{"status":"ok","timestamp":1791351933004,"user_tz":-330,"elapsed":13,"user":{"displayName":"N. Shashi Kiran","userId":"01258008085051097428"}}},"execution_count":4,"outputs":[]},{"cell_type":"markdown","source":["IT06"],"metadata":{"id":"Nr5gE8hV4_2-"}},{"cell_type":"code","source":["import os\n","import re\n","import csv\n","from collections import defaultdict\n","from datetime import datetime\n","\n","DATA_DIR = \"data\"\n","REPORT_DIR = os.path.join(DATA_DIR, \"reports\")\n","HISTORY = os.path.join(DATA_DIR, \"run_history.csv\")\n","SKIP = {\"report.txt\"}  # IT10 ka output, input mat banao\n","\n","LINE_RE = re.compile(r\"^\\s*([A-Z]{2}-\\d{4})\\s*\\|\\s*(-?\\d+)\\s*\\|\\s*(-?\\d+)\\s*$\")\n","\n","\n","def parse_line(line):\n","    m = LINE_RE.match(line)\n","    if not m:\n","        if not line.strip():\n","            return None, \"blank line\"\n","        fields = [p.strip() for p in line.split(\"|\")]\n","        if len(fields) != 3:\n","            return None, \"wrong number of fields\"\n","        if not re.fullmatch(r\"[A-Z]{2}-\\d{4}\", fields[0]):\n","            return None, f\"bad part code '{fields[0]}'\"\n","        return None, \"non-numeric quantity\"\n","    part, produced, scrap = m.group(1), int(m.group(2)), int(m.group(3))\n","    if produced < 0 or scrap < 0:\n","        return None, \"negative quantity\"\n","    if scrap > produced:\n","        return None, \"scrap exceeds produced\"\n","    return (part, produced, scrap), None\n","\n","\n","def process_file(path):\n","    totals = defaultdict(lambda: {\"produced\": 0, \"scrap\": 0, \"n\": 0})\n","    rejects, records = [], 0\n","    with open(path, \"r\", encoding=\"utf-8\") as f:\n","        for line_no, raw in enumerate(f, start=1):\n","            line = raw.rstrip(\"\\n\")\n","            records += 1\n","            data, reason = parse_line(line)\n","            if reason:\n","                rejects.append([line_no, line, reason])\n","                continue\n","            part, produced, scrap = data\n","            totals[part][\"produced\"] += produced\n","            totals[part][\"scrap\"] += scrap\n","            totals[part][\"n\"] += 1\n","    return totals, rejects, records\n","\n","\n","def write_report(path, title, totals, n_rejects, records):\n","    with open(path, \"w\", encoding=\"utf-8\") as f:\n","        f.write(f\"{title}\\n\" + \"=\" * 56 + \"\\n\")\n","        f.write(f\"{'PART':<10}{'RECORDS':>8}{'PRODUCED':>12}{'SCRAP':>8}{'SCRAP %':>10}\\n\")\n","        f.write(\"-\" * 56 + \"\\n\")\n","        gp = gs = gn = 0\n","        for part in sorted(totals):\n","            t = totals[part]\n","            pct = 100 * t[\"scrap\"] / t[\"produced\"] if t[\"produced\"] else 0\n","            f.write(f\"{part:<10}{t['n']:>8}{t['produced']:>12,}{t['scrap']:>8,}{pct:>9.2f}%\\n\")\n","            gp += t[\"produced\"]; gs += t[\"scrap\"]; gn += t[\"n\"]\n","        f.write(\"-\" * 56 + \"\\n\")\n","        gpct = 100 * gs / gp if gp else 0\n","        f.write(f\"{'TOTAL':<10}{gn:>8}{gp:>12,}{gs:>8,}{gpct:>9.2f}%\\n\")\n","        f.write(f\"\\nLines read: {records}  Accepted: {gn}  Rejected: {n_rejects}\\n\")\n","\n","\n","def write_rejects(path, rejects):\n","    with open(path, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n","        w = csv.writer(f)\n","        w.writerow([\"line_no\", \"raw_line\", \"reason\"])\n","        w.writerows(rejects)\n","\n","\n","def append_history(filename, records, n_rejects):\n","    new_file = not os.path.exists(HISTORY)\n","    with open(HISTORY, \"a\", newline=\"\", encoding=\"utf-8\") as f:\n","        w = csv.writer(f)\n","        if new_file:\n","            w.writerow([\"timestamp\", \"file\", \"records\", \"rejects\"])\n","        w.writerow([datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n","                    filename, records, n_rejects])\n","\n","\n","\n","os.makedirs(REPORT_DIR, exist_ok=True)\n","\n","combined = defaultdict(lambda: {\"produced\": 0, \"scrap\": 0, \"n\": 0})\n","all_records = all_rejects = files_done = 0\n","\n","for name in sorted(os.listdir(DATA_DIR)):\n","    path = os.path.join(DATA_DIR, name)\n","    if not (name.endswith(\".txt\") and os.path.isfile(path)) or name in SKIP:\n","        continue\n","\n","    stem = name[:-4]\n","    totals, rejects, records = process_file(path)\n","\n","    write_report(os.path.join(REPORT_DIR, f\"{stem}_report.txt\"),\n","                 f\"REPORT: {name}\", totals, len(rejects), records)\n","    write_rejects(os.path.join(REPORT_DIR, f\"{stem}_rejects.csv\"), rejects)\n","    append_history(name, records, len(rejects))\n","\n","    for part, t in totals.items():\n","        for k in (\"produced\", \"scrap\", \"n\"):\n","            combined[part][k] += t[k]\n","    all_records += records\n","    all_rejects += len(rejects)\n","    files_done += 1\n","    print(f\"{name}: {records} lines, {len(rejects)} rejected\")\n","\n","write_report(os.path.join(REPORT_DIR, \"plant_summary.txt\"),\n","             f\"PLANT SUMMARY ({files_done} files)\", combined, all_rejects, all_records)\n","print(f\"Batch done: {files_done} files.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"XxZMvVdH5BE-","executionInfo":{"status":"ok","timestamp":1791351950333,"user_tz":-330,"elapsed":39,"user":{"displayName":"N. Shashi Kiran","userId":"01258008085051097428"}},"outputId":"8644ea9e-2bc8-4662-dd21-fb2c6c855bf9"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["shift_log.txt: 19 lines, 6 rejected\n","Batch done: 1 files.\n"]}]}]}